{
  "name": "maxibot-2-desktop",
  "version": "2.1.2",
  "private": true,
  "description": "Maxibot autonome GPT/MEXC, observation puis ordres r\u00e9els",
  "author": "Maxibot Contributors",
  "license": "MIT",
  "type": "module",
  "main": "desktop/bootstrap.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/engine.test.mjs tests/cli.test.mjs tests/desktop.test.mjs tests/live.test.mjs tests/fomoapi.test.mjs",
    "check": "node scripts/check.mjs",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never"
  },
  "dependencies": {
    "jose": "5.10.0"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "26.17.0"
  },
  "engines": {
    "node": ">=24"
  },
  "build": {
    "appId": "com.maxibot.desktop2",
    "productName": "Maxibot 2.0",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "core/**",
      "ui/**",
      "web/data.mjs",
      "config.json",
      "docs/**",
      "README.md",
      "LICENSE",
      "package.json",
      "live/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "artifactName": "Maxibot-Setup-2.1.2-x64.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerLanguages": [
        "fr_FR"
      ],
      "language": "1036"
    },
    "portable": {
      "artifactName": "Maxibot-Portable-2.1.2-x64.exe"
    }
  }
}
